[sub_resource type="Resource" id="Resource_fx16m"]
script = ExtResource("6_qwha2")
text = "اهلا  سامي  كيف حالك؟ لا تقلق كل شئ كما تحب على موعدك"
speaker_name = "؟؟؟"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_w6aar"]
script = ExtResource("6_qwha2")
text = "حسن"
speaker_name = "سامي"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_hgaiw"]
script = ExtResource("6_qwha2")
text = "خذ…. هذا اللوح للطبيب و  جهاز راديو  للاستمتاع به اثناء الانتظار"
speaker_name = "؟؟؟"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_h25gc"]
script = ExtResource("6_qwha2")
