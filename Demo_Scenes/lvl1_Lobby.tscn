metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_t170u"]
script = ExtResource("6_qwha2")
text = "لا تقلق ليس ملك احد، لقد وجدته داخل غرفة مهجورة حتى حمتو لا يعلم به"
speaker_name = "؟؟؟"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

