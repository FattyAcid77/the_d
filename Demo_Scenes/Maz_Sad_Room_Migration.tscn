[ext_resource type="Script" uid="uid://cu70slxxwoesq" path="res://FD_Testing/GameSystems/DialogV2/Scripts/dialog_action_step.gd" id="12_n7u0w"]
[ext_resource type="Script" uid="uid://vlj7pu3occ4q" path="res://FD_Testing/GameSystems/DialogV2/Scripts/dialog.gd" id="13_8vx7g"]
[ext_resource type="Script" uid="uid://touqh4l3kjuq" path="res://FD_Testing/GameSystems/NPC/Scripts/npc_resource.gd" id="14_4guho"]
[ext_resource type="Texture2D" uid="uid://u2mx55p85ycy" path="res://characters scenes/NPC_Assets/qassor_and_natheef_.png" id="15_f2cys"]

[sub_resource type="Resource" id="Resource_8rqgk"]
script = ExtResource("9_dyqty")
text = "اهلا، اتمنى ان جلسة اليوم تكون جيدة و مفيدة، هل يمكنكم بأخباري عن اسمائكم ."
speaker_name = "سامي"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_nasf7"]
script = ExtResource("9_dyqty")
text = "انا نذيف و هذا اخي قسور"
speaker_name = "؟؟؟"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_fymg5"]
script = ExtResource("9_dyqty")
text = "اهلا نذيف و قسور … هل يمكنك اخباري عن مشاكلك، مشاعرك تغير في المشاعر او الافكار؟؟
"
speaker_name = "سامي"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_w0syh"]
script = ExtResource("9_dyqty")
text = " لا أعلم ما يُرجى من هذا… أنا بخير، فقط أشعر... بثقل. لا أعرف إن كان داخلي أو في الجو."
speaker_name = "نذيف"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_cmgme"]
script = ExtResource("9_dyqty")
text = " هو ليس بخير. لو أخبرتك فقط بما يفعله حين يختلي بنفسه، أو كيف ينهار عند أي كلمة قاسية…"
speaker_name = "قسور"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_w23mw"]
script = ExtResource("9_dyqty")
text = " وأنت، ما الذي يدفعك لتجرح دون أن تُستفز؟ حتى وأنا صامت، لا تنفك تبحث عن ثغرة في داخلي.
"
speaker_name = "نذيف"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_pf347"]
script = ExtResource("9_dyqty")
text = " قسور، هل يزعجك ضعف أخيك؟ أم يربكك؟"
speaker_name = "سامي"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_l5fbl"]
script = ExtResource("9_dyqty")
text = " لا يزعجني، لكنه... يوقظ شيئًا بداخلي لا أفهمه. أحيانًا أريد أن... أن أدفعه للحافة. لا أعرف لماذا."
speaker_name = "قسور"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_uhqlb"]
script = ExtResource("9_dyqty")
text = " هل تشعر بقوة حين يحدث ذلك؟"
speaker_name = "سامي"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_xihhx"]
script = ExtResource("9_dyqty")
text = " ربما… لا أُفكر فيها هكذا. فقط… أشعر بالوضوح. وكأنني أتنفس بعمق لأول مرة."
speaker_name = "قسور"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_mo03g"]
script = ExtResource("9_dyqty")
text = " وأنت، نذيف... ماذا تشعر حين يدفعك أخوك للحافة كما وصف؟"
speaker_name = "سامي"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_6mwk8"]
script = ExtResource("9_dyqty")
text = " لا أعرف. الأمر غريب. يؤلمني… لكنني لا أهرب. بل أنتظر أن يزيد. أحيانًا… أشعر أنني أستحق."
speaker_name = "نذيف"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_kaov2"]
script = ExtResource("9_dyqty")
text = " تستحق ماذا؟"
speaker_name = "سامي"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_drw8c"]
script = ExtResource("9_dyqty")
text = " العقاب... ربما. أو الاهتمام. لا يوجد فرق بينهما."
speaker_name = "نذيف"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_wau1j"]
script = ExtResource("9_dyqty")
text = " أنت تفكر هكذا؟! ظننتك فقط ضعيفًا... لا أنك تبحث عن الألم."
speaker_name = "قسور"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_82rpt"]
script = ExtResource("9_dyqty")
text = " هل تشعر أنك تحميه، قسور؟"
speaker_name = "سامي"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_rlfkm"]
script = ExtResource("9_dyqty")
text = " ما أعرف إذا وجب تسميتها  \"حماية\"... لكن لدي أحساس لو لم اكن موجود، كان اختفى."
speaker_name = "قسور"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_y0evb"]
script = ExtResource("9_dyqty")
text = " أحيانًا أتمنى أن أختفي فعلًا."
speaker_name = "نذيف"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_yg5dh"]
script = ExtResource("9_dyqty")
text = " ولماذا لم تفعل؟"
speaker_name = "سامي"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_h7qyw"]
script = ExtResource("9_dyqty")
text = " من الممكن... لأني أنتظره أن يلاحظ."
speaker_name = "نذيف"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_j0wmg"]
script = ExtResource("9_dyqty")
text = " تنتظرني؟ الاحظ ماذا  بتحديد؟"
speaker_name = "قسور"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_8x8xc"]
script = ExtResource("9_dyqty")
text = " أنك السبب والملاذ في نفس الوقت."
speaker_name = "نذيف"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_nlex2"]
script = ExtResource("9_dyqty")
text = "......"
speaker_name = "قسور"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_y0bb6"]
script = ExtResource("9_dyqty")
text = " أحيانًا العلاقات القريبة جدًا... تجعل الشخص لا يعرف من اين ينتهي هو، ومن اين يبدأ الثاني. أنتما متداخلان… لكن بطريقتين مختلفتين تمامًا."
speaker_name = "سامي"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_gjygd"]
script = ExtResource("9_dyqty")
text = " هو يحب يعاني… وأنا أكره أراه ساكن"
speaker_name = "قسور"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_s733x"]
script = ExtResource("9_dyqty")
text = " هو يرتاح عندما يقوم بضغط… عامل ، خادم ، او موظفينة"
speaker_name = "نذيف"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_db7cv"]
script = ExtResource("9_dyqty")
text = " أن يكون أحدكم مرآة للآخر، هذا ليس دائمًا شيء سيء… لكن إذا ان المرآة مشروخة، ماذا يحدث لانعكاس الصورة؟"
speaker_name = "سامي"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_stx34"]
script = ExtResource("9_dyqty")
text = " أحيانًا، يا قسور و نذيف، يخلق الإنسان في داخله طرقًا غريبة ليحتمي من ما لا يحتمل."
speaker_name = "سامي"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_pawq7"]
script = ExtResource("9_dyqty")
text = " هل تقول إن هذا… مرض؟"
speaker_name = "قسور"
metadata/_custom_type_script = "uid://c8gnwlh24codr"

[sub_resource type="Resource" id="Resource_x7o82"]
script = ExtResource("9_dyqty")
text = " لا أُحب أن أبدأ بكلمة \"مرض\". بل لنقل: نمط... تشكّل من تجارب. ويمكن فهمه، تفكيكه… وتغييره.
سامي:  شكرا على الحوار، و اعتذر منكم انتهى وقتي معكم"
speaker_name = "سامي"
set_flags = Array[String](["Maz_Sad_meeting1_finished", "Maz_Sad_door_open"])
metadata/_custom_type_script = "uid://c8gnwlh24codr"

