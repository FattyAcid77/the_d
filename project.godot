[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/initial_position_type=0
window/size/borderless=true
window/size/window_width_override=640
window/size/window_height_override=360
window/subwindows/embed_subwindows=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=true

[dotnet]

project/assembly_name="(D.) 2.0"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/cine_timeline/plugin.cfg")

[file_customization]

folder_colors={
"res://3MK-File/": "red",
"res://3MK-File/Resources/": "green",
"res://3MK-File/myshit/": "yellow"
}

